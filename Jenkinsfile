pipeline {
    agent any

    stages {

        stage("Build") {
            steps {
                echo "Building..."
            }
        }
          stage("Auto-fix") {
            steps {
                echo "fixing..."
            }
        }

        stage("Test") {
            steps {
                echo "Testing..."
            }
        }
          stage("deploy") {
            steps {
                echo "deploying..."
            }
        }

    }
}
